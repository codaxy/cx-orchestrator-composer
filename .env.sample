CONTAINER_PREFIX=some-cxo-project
COMPOSE_PROJECT_NAME=some-cxo-project
#CXO_TAG=26w19 # if not set = "latest"
#CXO_IMG_BASE_URL=<custom-container-images-repo-base-path> # if not set = "ghcr.io"
#HL_INFRA_IMG_BASE_URL=<custom-high-level-infra-images-repo-base-path> # " if not set = docker public image repo

# Identifies this CxO instance to the monitoring stack. Becomes the
# `cxo_instance` label on every metric / log / trace, surfaced in Grafana
# as the `$cxo_instance` dropdown across the dashboards.
# Set per environment (e.g. `local`, `staging`). Defaults to
# `local` in docker-compose.monitoring.yml if unset.
#CXO_INSTANCE_NAME=local
#CXO_ENVIRONMENT=local
# Orchestration engine: unset (or "conductor") for Netflix Conductor, "maestro" for CxMaestro.
# Set this to pick an engine for every run; pass --with-maestro to startup.sh to pick one for a
# single run.
#CXO_ORCHESTRATOR=maestro
# The monitoring stack's orchestrator Postgres exporter takes its whole DSN from here, because
# the two engines differ in host, database and credentials. Set it alongside CXO_ORCHESTRATOR
# whenever monitoring runs, or the exporter keeps pointing at a Conductor database that is no
# longer there.
#CXO_ORCHESTRATOR_DB_DSN=postgresql://maestro:maestro@cxo-maestrodb:5432/maestro?sslmode=disable
# Time zone of the orchestration engine and its database (and Kafka UI's database).
#CXO_TZ=Europe/Amsterdam
