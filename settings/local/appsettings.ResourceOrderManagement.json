{
  "ConnectionStrings": {
    "Database": "Host=cxo-db;Port=5432;Database=resource_order_management;Username=postgres;Password=postgres;Maximum Pool Size=4000;Timeout=30"
  },
  "Kafka": {
    "BootstrapServers": "cxo-kafka:9092"
  },
  "EventDispatcher": {
    "PollDelayMillis": 500,
    "BatchSize": 100
  },
  "Errors": {
    "LogRequestBody": true,
    "LogEveryRequest": "post, put, patch, delete"
  },
  "EnableSwagger": true
}
