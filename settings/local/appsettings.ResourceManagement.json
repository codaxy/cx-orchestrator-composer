{
  "Serilog": {
    "Properties": {
      "Application": "cxo-resource-management"
    }
  },
  "Kafka": {
    "BootstrapServers": "cxo-kafka:9092"
  },
  "Errors": {
    "LogRequestBody": true,
    "LogEveryRequest": "post, put, patch, delete"
  },
  "EnableSwagger": true,
  "EventDispatcher": {
    "PollDelayMillis": 500,
    "BatchSize": 100
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://0.0.0.0:8080",
        "Protocols": "Http1"
      },
      "Http2": {
        "Url": "http://0.0.0.0:8090",
        "Protocols": "Http2"
      }
    }
  },
  "Conductor": {
    "BaseUrl": "http://cxo-conductor:8080",
    "MaxConcurrentWorkers": 100,
    "KafkaCancellationNotifier": {
      "BootstrapServers": "cxo-kafka:9092"
    }
  },
  "TmfApi": {
    "ResourceOrderingManagementV4BaseUrl": "http://127.0.0.1:8080/tmf-api/resourceOrderingManagement/v4/",
    "ResourceInventoryManagementV4BaseUrl": "http://127.0.0.1:8080/tmf-api/resourceInventoryManagement/v4/",
    "ResourceCatalogManagementV4BaseUrl": "http://127.0.0.1:8080/tmf-api/resourceCatalog/v4/"
  },
  "Modules": {
    "ResourceCatalogManagement": {
      "ConnectionStrings": {
        "Database": "Host=cxo-db;Port=5432;Database=resource_catalog_management;Username=postgres;Password=postgres;Maximum Pool Size=4000;Timeout=30"
      }
    },
    "ResourceInventoryManagement": {
      "ConnectionStrings": {
        "Database": "Host=cxo-db;Port=5432;Database=resource_inventory_management;Username=postgres;Password=postgres;Maximum Pool Size=4000;Timeout=30"
      }
    },
    "ResourceOrderManagement": {
      "ConnectionStrings": {
        "Database": "Host=cxo-db;Port=5432;Database=resource_order_management;Username=postgres;Password=postgres;Maximum Pool Size=4000;Timeout=30"
      }
    },
    "ResourceOrderingEngine": {
      "ConnectionStrings": {
        "Database": "Host=cxo-db;Port=5432;Database=resource_ordering_engine;Username=postgres;Password=postgres;Maximum Pool Size=4000;Timeout=30"
      }
    },
    "ResourcePoolManagement": {
      "ConnectionStrings": {
        "Database": "Host=cxo-db;Port=5432;Database=resource_pool_management;Username=postgres;Password=postgres;Maximum Pool Size=4000;Timeout=30"
      }
    }
  }
}
