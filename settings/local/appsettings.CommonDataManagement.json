{
  "Serilog": {
    "Properties": {
      "Application": "cxo-common-data-management"
    }
  },
  "Kafka": {
    "BootstrapServers": "cxo-kafka:9092"
  },
  "Errors": {
    "LogRequestBody": true,
    "LogEveryRequest": "post, put, patch, delete"
  },
  "EnableSwagger": true,
  "Modules": {
    "CustomerManagement": {
      "ConnectionStrings": {
        "Database": "Host=cxo-db;Port=5432;Database=customer_management;Username=postgres;Password=postgres;Maximum Pool Size=4000;Timeout=30"
      }
    },
    "DigitalIdentityManagement": {
      "ConnectionStrings": {
        "Database": "Host=cxo-db;Port=5432;Database=digital_identity;Username=postgres;Password=postgres;Maximum Pool Size=4000;Timeout=30"
      }
    },
    "EventManagement": {
      "ConnectionStrings": {
        "Database": "Host=cxo-db;Port=5432;Database=event_management;Username=postgres;Password=postgres;Maximum Pool Size=4000;Timeout=30"
      }
    },
    "GeographicAddressManagement": {
      "ConnectionStrings": {
        "Database": "Host=cxo-db;Port=5432;Database=geographic_address_management;Username=postgres;Password=postgres;Maximum Pool Size=4000;Timeout=30"
      }
    },
    "GeographicLocationManagement": {
      "ConnectionStrings": {
        "Database": "Host=cxo-db;Port=5432;Database=geographic_location_management;Username=postgres;Password=postgres;Maximum Pool Size=4000;Timeout=30"
      }
    },
    "GeographicSiteManagement": {
      "ConnectionStrings": {
        "Database": "Host=cxo-db;Port=5432;Database=geographic_site_management;Username=postgres;Password=postgres;Maximum Pool Size=4000;Timeout=30"
      }
    },
    "PartyManagement": {
      "ConnectionStrings": {
        "Database": "Host=cxo-db;Port=5432;Database=party_management;Username=postgres;Password=postgres;Maximum Pool Size=4000;Timeout=30"
      }
    },
    "PartyRoleManagement": {
      "ConnectionStrings": {
        "Database": "Host=cxo-db;Port=5432;Database=party_role_management;Username=postgres;Password=postgres;Maximum Pool Size=4000;Timeout=30"
      }
    },
    "UserRolePermissions": {
      "ConnectionStrings": {
        "Database": "Host=cxo-db;Port=5432;Database=user_roles_and_permissions;Username=postgres;Password=postgres;Maximum Pool Size=4000;Timeout=30"
      }
    },
    "Settings": {
      "ConnectionStrings": {
        "Database": "Host=cxo-db;Port=5432;Database=cxo_settings;Username=postgres;Password=postgres;Maximum Pool Size=4000;Timeout=30"
      }
    },
    "CxoLockingManagement": {
      "ConnectionStrings": {
        "Database": "Host=cxo-db;Port=5432;Database=locking_management;Username=postgres;Password=postgres;Maximum Pool Size=4000;Timeout=30"
      },
      "Kafka": {
        "ConsumerGroupId": "cxo"
      }
    },
    "CxoAudit": {
      "ConnectionStrings": {
        "Database": "Host=cxo-db;Port=5432;Database=audit;Username=postgres;Password=postgres;Maximum Pool Size=4000;Timeout=30"
      },
      "Audit": {
        "Topics": [
          "cxo-customer-management",
          "cxo-digital-identity-management",
          "cxo-geographic-address-management",
          "cxo-geographic-location-management",
          "cxo-geographic-site-management",
          "cxo-party-management.individual",
          "cxo-party-management.organization",
          "cxo-party-role-management",
          "cxo-resource-catalog-management.resource-catalog",
          "cxo-resource-catalog-management.resource-category",
          "cxo-resource-catalog-management.resource-specification",
          "cxo-resource-catalog-management.resource-candidate",
          "cxo-resource-inventory-management",
          "cxo-resource-order-management.resource-order",
          "cxo-resource-order-management.cancel-resource-order",
          "cxo-service-activation-management.monitor",
          "cxo-service-catalog-management.service-catalog",
          "cxo-service-catalog-management.service-category",
          "cxo-service-catalog-management.service-specification",
          "cxo-service-catalog-management.service-candidate",
          "cxo-service-inventory-management",
          "cxo-service-order-management.service-order",
          "cxo-service-order-management.cancel-service-order",
          "cxo-user-roles-and-permissions.permission",
          "cxo-user-roles-and-permissions.user-role"
        ]
      }
    }
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://0.0.0.0:8080",
        "Protocols": "Http1"
      },
      "Http2": {
        "Url": "http://0.0.0.0:8090",
        "Protocols": "Http2"
      }
    }
  },
  "Conductor": {
    "BaseUrl": "http://cxo-conductor:8080"
  }
}
