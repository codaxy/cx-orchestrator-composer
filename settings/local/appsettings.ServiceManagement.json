{
  "Serilog": {
    "Properties": {
      "Application": "cxo-service-management"
    }
  },
  "Kafka": {
    "BootstrapServers": "cxo-kafka:9092"
  },
  "Errors": {
    "LogRequestBody": true,
    "LogEveryRequest": "post, put, patch, delete"
  },
  "EnableSwagger": true,
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://0.0.0.0:8080",
        "Protocols": "Http1"
      },
      "Http2": {
        "Url": "http://0.0.0.0:8090",
        "Protocols": "Http2"
      }
    }
  },
  "Conductor": {
    "BaseUrl": "http://cxo-conductor:8080",
    "MaxConcurrentWorkers": 100,
    "KafkaCancellationNotifier": {
      "BootstrapServers": "cxo-kafka:9092"
    }
  },
  "TmfApi": {
    "ServiceOrderingManagementV4BaseUrl": "http://127.0.0.1:8080/tmf-api/serviceOrdering/v4/",
    "ServiceInventoryManagementV4BaseUrl": "http://127.0.0.1:8080/tmf-api/serviceInventory/v4/",
    "ServiceCatalogManagementV4BaseUrl": "http://127.0.0.1:8080/tmf-api/serviceCatalogManagement/v4/"
  },
  "ResourceOrderingEngine": {
    "BaseUrl": "http://cxo-resource-ordering-engine:8080"
  },
  "Modules": {
    "ServiceCatalogManagement": {
      "ConnectionStrings": {
        "Database": "Host=cxo-db;Port=5432;Database=service_catalog_management;Username=postgres;Password=postgres;Maximum Pool Size=4000;Timeout=30"
      }
    },
    "ServiceInventoryManagement": {
      "ConnectionStrings": {
        "Database": "Host=cxo-db;Port=5432;Database=service_inventory_management;Username=postgres;Password=postgres;Maximum Pool Size=4000;Timeout=30"
      }
    },
    "ServiceOrderManagement": {
      "ConnectionStrings": {
        "Database": "Host=cxo-db;Port=5432;Database=service_order_management;Username=postgres;Password=postgres;Maximum Pool Size=4000;Timeout=30"
      }
    },
    "ServiceOrderingEngine": {
      "ConnectionStrings": {
        "Database": "Host=cxo-db;Port=5432;Database=service_ordering_engine;Username=postgres;Password=postgres;Maximum Pool Size=4000;Timeout=30"
      }
    },
    "ServiceActivationManagement": {
      "ConnectionStrings": {
        "Database": "Host=cxo-db;Port=5432;Database=service_activation_management;Username=postgres;Password=postgres;Maximum Pool Size=4000;Timeout=30"
      }
    }
  }
}
