{
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://0.0.0.0:8080",
        "Protocols": "Http1"
      },
      "Http2": {
        "Url": "http://0.0.0.0:8090",
        "Protocols": "Http2"
      }
    }
  },
  "Conductor": {
    "BaseUrl": "http://cxo-conductor:8080"
  },
  "TmfApi": {
    "ServiceInventoryManagementV4BaseUrl": "http://cxo-service-inventory-management:8080/tmf-api/serviceInventory/v4/",
    "ServiceCatalogManagementV4BaseUrl": "http://cxo-service-catalog-management:8080/tmf-api/serviceCatalogManagement/v4/"
  },
  "Workflows": {
    "IncludeDummyActivation": true
  },
  "ConnectionStrings": {
    "Database": "Host=cxo-db;Port=5432;Database=service_activation_management;Username=postgres;Password=postgres;Maximum Pool Size=4000;Timeout=30"
  },
  "Kafka": {
    "BootstrapServers": "cxo-kafka:9092"
  },
  "EnableSwagger": true
}
