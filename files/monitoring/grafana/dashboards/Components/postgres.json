      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (db_role) (pg_custom_longest_query_seconds{environment=~\"$environment\", cxo_instance=~\"$cxo_instance\", db_role=~\"$db_role\"})",
          "legendFormat": "{{ db_role }}",
          "refId": "A"
        }
      ],
      "title": "Longest running query (seconds)",
      "type": "timeseries",
      "description": "Age of the longest currently-running query, per database role."
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
