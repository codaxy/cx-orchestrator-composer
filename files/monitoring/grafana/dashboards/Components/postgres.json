      },
      "id": 22,
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "pg_custom_database_size_bytes{environment=~\"$environment\", cxo_instance=~\"$cxo_instance\", db_role=~\"$db_role\", database!~\"template.*\"}",
          "legendFormat": "{{ db_role }} / {{ database }}",
          "refId": "A"
        }
      ],
      "title": "Database size",
      "type": "timeseries",
      "description": "On-disk size per database."
    }
