      "id": 1,
      "panels": [],
      "title": "Availability & Connections",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "options": {
                "0": {
                  "color": "red",
                  "text": "DOWN"
                }
              },
              "type": "value"
            },
            {
              "options": {
                "1": {
                  "color": "green",
                  "text": "UP"
                }
              },
              "type": "value"
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "noValue": "N/A"
        }
      },
      "gridPos": {
        "h": 4,
        "w": 2,
        "x": 0,
        "y": 1
      },
      "id": 2,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value"
      },
      "pluginVersion": "11",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "pg_up{environment=~\"$environment\", cxo_instance=~\"$cxo_instance\", db_role=\"application\"}",
          "refId": "A"
        }
      ],
      "title": "application",
      "type": "stat",
      "description": "Postgres exporter reachability for the application DB server. Red N/A means the exporter itself is unreachable."
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "options": {
                "0": {
                  "color": "red",
                  "text": "DOWN"
                }
              },
              "type": "value"
            },
            {
              "options": {
                "1": {
                  "color": "green",
                  "text": "UP"
                }
              },
              "type": "value"
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "noValue": "N/A"
        }
      },
      "gridPos": {
        "h": 4,
        "w": 2,
        "x": 2,
        "y": 1
      },
      "id": 13,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value"
      },
      "pluginVersion": "11",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "pg_up{environment=~\"$environment\", cxo_instance=~\"$cxo_instance\", db_role=\"orchestrator\"}",
          "refId": "A"
        }
      ],
      "title": "orchestrator",
      "type": "stat",
      "description": "Postgres exporter reachability for the orchestration engine's database server, whichever engine is running. Red N/A means the exporter itself is unreachable."
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 70
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          },
          "unit": "percent",
          "min": 0,
          "max": 100
        }
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 4,
        "y": 1
      },
      "id": 3,
      "options": {
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "pluginVersion": "11",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (db_role) (pg_custom_connections_used_pct{environment=~\"$environment\", cxo_instance=~\"$cxo_instance\", db_role=~\"$db_role\"})",
          "legendFormat": "{{ db_role }}",
          "refId": "A"
        }
      ],
      "title": "Connection saturation",
      "type": "gauge",
      "description": "Connections used as a percentage of max_connections, per database role."
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 1,
            "showPoints": "auto"
          },
          "color": {
            "mode": "palette-classic"
          }
        }
      },
      "gridPos": {
        "h": 8,
        "w": 14,
        "x": 10,
        "y": 1
      },
      "id": 4,
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (database, state) (pg_custom_connections_active{environment=~\"$environment\", cxo_instance=~\"$cxo_instance\", db_role=~\"$db_role\"})",
          "legendFormat": "{{ database }} / active",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (database) (pg_custom_connections_idle{environment=~\"$environment\", cxo_instance=~\"$cxo_instance\", db_role=~\"$db_role\"})",
          "legendFormat": "{{ database }} / idle",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (database) (pg_custom_connections_idle_in_transaction{environment=~\"$environment\", cxo_instance=~\"$cxo_instance\", db_role=~\"$db_role\"})",
          "legendFormat": "{{ database }} / idle_in_tx",
          "refId": "C"
        }
      ],
      "title": "Connections by state (per database)",
      "type": "timeseries",
      "description": "Active, idle, and idle-in-transaction connections per database."
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 9
      },
      "id": 10,
      "panels": [],
      "title": "Throughput & Cache",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 1
          },
          "color": {
            "mode": "palette-classic"
          },
          "unit": "ops"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 10
      },
      "id": 11,
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "mean"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (datname) (rate(pg_stat_database_xact_commit{environment=~\"$environment\", cxo_instance=~\"$cxo_instance\", db_role=~\"$db_role\", datname!~\"template.*|\"}[$__rate_interval]))",
          "legendFormat": "{{ datname }} / commit",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (datname) (rate(pg_stat_database_xact_rollback{environment=~\"$environment\", cxo_instance=~\"$cxo_instance\", db_role=~\"$db_role\", datname!~\"template.*|\"}[$__rate_interval]))",
          "legendFormat": "{{ datname }} / rollback",
          "refId": "B"
        }
      ],
      "title": "Transactions per second",
      "type": "timeseries",
      "description": "Transaction commits and rollbacks per second, per database."
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 1
          },
          "color": {
            "mode": "palette-classic"
          },
          "unit": "percentunit",
          "min": 0,
          "max": 1
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 10
      },
      "id": 12,
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "mean"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (datname) (rate(pg_stat_database_blks_hit{environment=~\"$environment\", cxo_instance=~\"$cxo_instance\", db_role=~\"$db_role\", datname!~\"template.*|\"}[$__rate_interval])) / clamp_min(sum by (datname) (rate(pg_stat_database_blks_hit{environment=~\"$environment\", cxo_instance=~\"$cxo_instance\", db_role=~\"$db_role\", datname!~\"template.*|\"}[$__rate_interval]) + rate(pg_stat_database_blks_read{environment=~\"$environment\", cxo_instance=~\"$cxo_instance\", db_role=~\"$db_role\", datname!~\"template.*|\"}[$__rate_interval])), 1)",
          "legendFormat": "{{ datname }}",
          "refId": "A"
        }
      ],
      "title": "Cache hit ratio",
      "type": "timeseries",
      "description": "Share of block reads served from shared buffers (cache) per database — sustained drops mean disk pressure."
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
