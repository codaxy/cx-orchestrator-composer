              {
                "color": "green",
                "value": null
              }
            ]
          },
          "unit": "ms"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 12
      },
      "id": 6,
      "options": {
        "cellHeight": "sm",
        "footer": {
          "countRows": false,
          "fields": "",
          "reducer": [
            "sum"
          ],
          "show": false
        },
        "showHeader": true,
        "sortBy": [
          {
            "desc": true,
            "displayName": "p95"
          }
        ]
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "expr": "quantile_over_time(0.95, {service_name=~\"$service\"} | environment=~\"$environment\" | cxo_instance=~\"$cxo_instance\" | EventType != \"\" | DurationMs >= 0 | unwrap DurationMs [$__range]) by (service_name, EventType)",
          "instant": true,
          "queryType": "instant",
          "refId": "A"
        }
      ],
      "title": "p95 Duration (by service and event type)",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {},
            "renameByName": {
              "service_name": "Service",
              "Value #A": "p95"
            }
          }
        }
      ],
      "type": "table"
    },
