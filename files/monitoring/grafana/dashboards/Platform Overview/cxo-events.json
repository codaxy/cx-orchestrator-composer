          "editorMode": "code",
          "expr": "(sum(count_over_time({service_name=~\"$service\"} | environment=~\"$environment\" | cxo_instance=~\"$cxo_instance\" | EventType != \"\" | Status=\"Failed\" [$__range])) or vector(0)) / sum(count_over_time({service_name=~\"$service\"} | environment=~\"$environment\" | cxo_instance=~\"$cxo_instance\" | EventType != \"\" [$__range]))",
