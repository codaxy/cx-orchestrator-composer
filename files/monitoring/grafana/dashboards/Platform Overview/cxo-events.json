    {
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "description": "p95 duration per event type, computed from the DurationMs envelope field via unwrap — no text parsing. Events without a duration are excluded.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
