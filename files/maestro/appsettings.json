// CxMaestro configuration for the CxO stack.
//
// Mounted over /app/appsettings-mounted/0/appsettings.json, which the engine reads on top of
// the appsettings.json baked into its image. Only the keys below are overridden; everything
// else keeps the image's default.
//
// This layer wins over environment variables: the engine registers these files after the host
// builder has already added the environment-variable provider, and the last provider added
// wins. A setting listed here therefore cannot be overridden from the compose file or from
// .env. Settings that have to vary per deployment stay in docker-compose.maestro.yml instead.
{
  "Storage": {
    "Provider": "Postgres",
    "ConnectionString": "Host=cxo-maestrodb;Port=5432;Database=maestro;Username=maestro;Password=maestro"
  },

  "Engine": {
    "CoreCount": 4,
    "Kafka": {
      "Enabled": false
    }
  }
}
